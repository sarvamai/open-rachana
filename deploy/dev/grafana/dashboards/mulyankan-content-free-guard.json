{
  "uid": "mulyankan-content-free-guard",
  "title": "Mulyankan / Content-free guard",
  "description": "What the in-process allowlist removed before export, by signal and attribute key (spec §4.2). A new key appearing here means an instrumentation started emitting something the allowlist does not know; the value is a key name, never content.",
  "tags": [
    "mulyankan",
    "development"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "service.name",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(target_info, service_name)",
          "refId": "svc"
        },
        "definition": "label_values(target_info, service_name)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "text": "core-api",
          "value": "core-api"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
