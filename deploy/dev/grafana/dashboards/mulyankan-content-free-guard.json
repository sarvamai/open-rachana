    {
      "id": 10,
      "type": "text",
      "title": "About this dashboard",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "datasource": null,
      "targets": [],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "The guard in `platform/core/.../observability/guard.py` removes every span and log attribute that is not on the allowlist and counts each removal in `mulyankan.observability.attributes_dropped`. Expected keys from the FastAPI instrumentation: `url.path`, `url.query`, `user_agent.original`, `client.port`, `exception.message`, `exception.escaped`. Anything else is worth a look. Metric attributes are dropped silently by an SDK View and do not appear here."
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Attributes dropped / s",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mulyankan_observability_attributes_dropped_total{service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "dropped"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "area",
        "textMode": "value"
      }
    },
